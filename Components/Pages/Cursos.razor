@page "/cursos"
@rendermode InteractiveServer
@using LP3.Shared.DTOs
@using LP3.BlazorServer.Application.Services
@using LP3.BlazorServer.Domain.Enums 


@inject ICursoService CursoService

<div class="container mt-5">
    <h1>📚 Gestión de Cursos</h1>
    <p class="text-muted">Aquí puedes crear, consultar, editar y eliminar cursos</p>
    
    <!-- Aquí irán las secciones de búsqueda, registro, edición y eliminación -->
    <div class="card mb-4">
    <div class="card-body">
        <h4>🔍 Buscar Curso por Código</h4>
        
        <div class="input-group">
            <input 
                type="text" 
                class="form-control" 
                @bind="codigoBusqueda" 
                placeholder="Ej: 2024001" />
            <button class="btn btn-primary" @onclick="BuscarPorcodigo">
                Buscar
            </button>
        </div>

        @if (cursoBuscado != null)
        {
            <div class="alert alert-info mt-3">
                <strong>✓ Encontrado:</strong> 
                @cursoBuscado.Nombre @cursoBuscado.Codigo 
                (ID: @cursoBuscado.Id)
            </div>
        }
    </div>
</div>
<!-- Aquí irán las secciones de búsqueda, registro, edición y eliminación -->
<div class="card mb-4">
    <div class="card-body">
        <h4>➕ Registrar Nuevo Curso</h4>
        
        <EditForm FormName="registroCursoForm" Model="nuevoCurso" OnValidSubmit="RegistrarCurso">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="nombre" class="form-label">Nombre:</label>
                    <InputText id="nombre" @bind-Value="nuevoCurso.Nombre" 
                               class="form-control" 
                               placeholder="Ej: Matemáticas" />
                </div>

                <div class="col-md-6 mb-3">
                    <label for="creditos-new" class="form-label">Créditos:</label>
                    <InputText id="creditos-new" @bind-Value="nuevoCurso.Creditos" 
                               class="form-control" 
                               placeholder="Ej: 3" />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label for="codigo-new" class="form-label">Código:</label>
                    <InputText id="codigo-new" @bind-Value="nuevoCurso.Codigo" 
                               class="form-control" 
                               placeholder="Ej: IRI-005" />
                </div>
                <div class="col-md-6 mb-3">
                    <label for="activo-new" class="form-label">Estado:</label>
                    <div class="form-check mt-2">
                        <InputCheckbox id="activo-new" @bind-Value="cursoActivoNuevo" 
                                       class="form-check-input" />
                        <label class="form-check-label" for="activo-new">
                            @(cursoActivoNuevo ? "✓ Activo" : "✗ Inactivo")
                        </label>
                    </div>
                </div>
            </div> 

            <button type="submit" class="btn btn-success">
                ✓ Guardar Curso
            </button>
        </EditForm>

        @if (!string.IsNullOrEmpty(mensajeRegistro))
        {
            <div class="alert mt-3" style="@(mensajeRegistro.StartsWith(value: "✅") ? "background: #d4edda;" : "background: #f8d7da;")">
                @mensajeRegistro
            </div>
        }
    </div>
</div>
<div class="card">
    <div class="card-body">
        <h4>📊 Cursos Registrados (@cursos?.Count)</h4>
        
        @if (cursos == null || cursos.Count == 0)
        {
            <div class="alert alert-info">
                No hay cursos registrados aún.
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-striped table-hover">
                    <thead class="table-dark">
                        <tr>
                            <th>ID</th>
                            <th>Nombre</th>
                            <th>Créditos</th>
                            <th>Código</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (CursoDto est in cursos ?? [])
                        {
                            <tr>
                                <td>@est.Id</td>
                                <td>@est.Nombre</td>
                                <td>@est.Creditos</td>
                                <td><strong>@est.Codigo</strong></td>
                                <td>
                                    @if (bool.TryParse(est.Activo, out bool activo))
                                    {
                                        @if (activo)
                                        {
                                            <span class="badge bg-success">✓ Activo</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">✗ Inactivo</span>
                                        }
                                    }
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-warning" 
                                            @onclick="() => CargarParaEditar(est)">
                                        ✏️ Editar
                                    </button>
                                    <button class="btn btn-sm btn-danger" 
                                            @onclick="() => ConfirmarEliminar(est.Id)">
                                        🗑️ Eliminar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
<!-- Aquí irán las secciones de búsqueda, registro, edición y eliminación -->
@if (editandoCurso != null)
{
    <div class="card mt-4 border-warning">
        <div class="card-body">
            <h4>✏️ Editar Curso</h4>
            
            <EditForm Model="editandoCurso" OnValidSubmit="GuardarCambios">
                <DataAnnotationsValidator />
                <ValidationSummary />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="nombre-edit" class="form-label">Nombre:</label>
                        <InputText id="nombre-edit" @bind-Value="editandoCurso.Nombre" 
                                   class="form-control" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label for="creditos-edit" class="form-label">Créditos:</label>
                        <InputText id="creditos-edit" @bind-Value="editandoCurso.Creditos" 
                                   class="form-control" />
                    </div>
                </div>

               <div class="row">
                    <div class="col-md-6 mb-3">
                        <label for="codigo-edit" class="form-label">Código (No editable):</label>
                        <InputText id="codigo-edit" @bind-Value="editandoCurso.Codigo" 
                                   class="form-control" disabled />
                    </div>
                    <div class="col-md-6 mb-3">
                        <label for="activo-edit" class="form-label">Estado:</label>
                        <div class="form-check mt-2">
                            <InputCheckbox id="activo-edit" @bind-Value="cursoActivoEdicion" 
                                           class="form-check-input" />
                            <label class="form-check-label" for="activo-edit">
                                @(cursoActivoEdicion ? "✓ Activo" : "✗ Inactivo")
                            </label>
                        </div>
                    </div>
                </div>

                <button type="submit" class="btn btn-primary">
                    ✓ Guardar Cambios
                </button>
                <button type="button" class="btn btn-secondary" @onclick="CancelarEdicion">
                    ✕ Cancelar
                </button>
            </EditForm>
        </div>
    </div>
}
@if (mostrarConfirmacionEliminar)
{
    <div class="card mt-4 border-danger">
        <div class="card-body">
            <div class="alert alert-danger" role="alert">
                <h5>⚠️ Confirmar Eliminación</h5>
                <p>¿Está seguro de que desea eliminar este curso?</p>
                <p style="color: #721c24; font-size: 0.9em;">
                    <strong>Esta acción no se puede deshacer.</strong>
                </p>
                
                <button class="btn btn-danger" @onclick="EliminarCurso">
                    Sí, Eliminar Permanentemente
                </button>
                <button class="btn btn-secondary" @onclick="CancelarEliminar">
                    Cancelar
                </button>
            </div>
        </div>
    </div>
}
</div>

@code {
    // Variables para almacenar datos
    private ICollection<CursoDto> cursos = new List<CursoDto>();
    private string mensajeRegistro = string.Empty;

    // Variables para búsqueda
    private string codigoBusqueda = string.Empty;
    private CursoDto? cursoBuscado;

    // Variables para nuevo registro
    private CursoDto nuevoCurso = new CursoDto();

    // Variables para edición
    private CursoDto? editandoCurso;
    private int idCursoEditando = 0;

    // Variables para eliminación
    private bool mostrarConfirmacionEliminar = false;
    private int idCursoAEliminar = 0;

    // Variables para estado activo
    private bool cursoActivoNuevo = true;
    private bool cursoActivoEdicion = true;

    protected override async Task OnInitializedAsync()
    {
        await CargarCursos();
    }

    private async Task CargarCursos()
    {
        cursos = await CursoService.GetAll();
    }

    private async Task BuscarPorcodigo()
    {
        if (string.IsNullOrWhiteSpace(codigoBusqueda))
        {
            mensajeRegistro = "Por favor ingresa un código";
            return;
        }

        cursoBuscado = await CursoService.GetByCodigoAsync(codigoBusqueda);

        if (cursoBuscado == null)
        {
            mensajeRegistro = "❌ No se encontró un curso con ese código";
        }
    }

    private async Task RegistrarCurso()
    {
        if (string.IsNullOrWhiteSpace(nuevoCurso.Nombre) ||
            string.IsNullOrWhiteSpace(nuevoCurso.Codigo) ||
            string.IsNullOrWhiteSpace(nuevoCurso.Creditos))
        {
            mensajeRegistro = "⚠️ Por favor completa todos los campos requeridos";
            return;
        }

        // Establecer estado Activo desde el checkbox
        nuevoCurso.Activo = cursoActivoNuevo.ToString();

        bool resultado = await CursoService.CreateAsync(nuevoCurso);

        if (resultado)
        {
            mensajeRegistro = "✅ Curso registrado exitosamente";
            nuevoCurso = new CursoDto(); // Limpiar formulario
            cursoActivoNuevo = true; // Resetear checkbox
            await CargarCursos(); // Actualizar lista
        }
        else
        {
            mensajeRegistro = "❌ Error al registrar el curso. Verifica que el código sea único";
        }
    }
    private void CargarParaEditar(CursoDto curso)
    {
        editandoCurso = new CursoDto
        {
            Id = curso.Id,
            Nombre = curso.Nombre,
            Codigo = curso.Codigo,
            Creditos = curso.Creditos,
            Activo = curso.Activo

        };
        idCursoEditando = curso.Id;
        // Cargar estado del checkbox de edición
        cursoActivoEdicion = bool.TryParse(curso.Activo, out bool activo) ? activo : true;
    }

    private async Task GuardarCambios()
    {
        if (editandoCurso == null) return;

        // Actualizar estado Activo desde el checkbox
        editandoCurso.Activo = cursoActivoEdicion.ToString();

        bool resultado = await CursoService.UpdateAsync(idCursoEditando, editandoCurso);

        if (resultado)
        {
            mensajeRegistro = "✅ Curso actualizado exitosamente";
            editandoCurso = null;
            idCursoEditando = 0;
            await CargarCursos();
        }
        else
        {
            mensajeRegistro = "❌ Error al actualizar el curso";
        }
    }

    private void CancelarEdicion()
    {
        editandoCurso = null;
        idCursoEditando = 0;
    }   
    private void ConfirmarEliminar(int id)
    {
        idCursoAEliminar = id;
        mostrarConfirmacionEliminar = true;
    }

    private async Task EliminarCurso()
    {
        bool resultado = await CursoService.DeleteAsync(idCursoAEliminar);

        if (resultado)
        {
            mensajeRegistro = "✅ Curso eliminado exitosamente";
            mostrarConfirmacionEliminar = false;
            idCursoAEliminar = 0;
            await CargarCursos();
        }
        else
        {
            mensajeRegistro = "❌ Error al eliminar el curso";
        }
    }

    private void CancelarEliminar()
    {
        mostrarConfirmacionEliminar = false;
        idCursoAEliminar = 0;
    }
}